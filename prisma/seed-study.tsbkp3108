// Tiny, standalone seed for the /learn feature's study content. Deliberately
// separate from prisma/seed.ts (which owns questions/categories/articles) so
// running this can never touch or duplicate that data. Safe to re-run —
// every write is an upsert keyed on a unique slug.
import { PrismaClient, StudyLevel, Difficulty } from "@prisma/client";

const prisma = new PrismaClient();
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

async function main() {
  const category = await prisma.studyCategory.upsert({
    where: { slug: "javascript-fundamentals" },
    update: {},
    create: {
      name: "JavaScript Fundamentals",
      slug: "javascript-fundamentals",
      description: "The core JavaScript concepts that come up again and again in technical interviews — explained once, properly.",
      icon: "🟨",
      isPublished: true,
      sortOrder: 0,
    },
  });

  const path = await prisma.studyPath.upsert({
    where: { categoryId_slug: { categoryId: category.id, slug: "beginner" } },
    update: {},
    create: {
      categoryId: category.id,
      name: "Beginner path",
      slug: "beginner",
      description: "Start here if you're new to JavaScript or want to firm up the basics before an interview.",
      level: StudyLevel.BEGINNER,
      isPublished: true,
      sortOrder: 0,
    },
  });

  const learnModule = await prisma.studyModule.upsert({
    where: { studyPathId_slug: { studyPathId: path.id, slug: "core-concepts" } },
    update: {},
    create: {
      studyPathId: path.id,
      title: "Core concepts",
      slug: "core-concepts",
      description: "The building blocks: how values, scope, and equality actually work.",
      isPublished: true,
      sortOrder: 0,
    },
  });

  const closures = await prisma.studyTopic.upsert({
    where: { categoryId_slug: { categoryId: category.id, slug: "closures" } },
    update: {},
    create: {
      moduleId: learnModule.id,
      categoryId: category.id,
      title: "Closures",
      slug: "closures",
      shortDescription: "Why a function can still see variables from where it was created, even after that outer function has already returned.",
      estimatedMinutes: 8,
      isPublished: true,
      sortOrder: 0,
      seoTitle: "JavaScript Closures Explained",
      seoDescription: "A clear, practical explanation of JavaScript closures with a worked example and a practice exercise.",
    },
  });

  await prisma.studyTopicSection.upsert({
    where: { id: `${closures.id}-what` },
    update: {},
    create: {
      id: `${closures.id}-what`,
      topicId: closures.id,
      title: "What a closure actually is",
      content: "A closure is what happens when an inner function keeps access to variables from the outer function it was defined inside, even after that outer function has finished running.\n\nJavaScript doesn't throw those variables away just because the outer function returned. As long as some inner function still references them, they stay alive in memory, tied to that specific function call.",
      sortOrder: 0,
    },
  });

  await prisma.studyTopicSection.upsert({
    where: { id: `${closures.id}-why` },
    update: {},
    create: {
      id: `${closures.id}-why`,
      topicId: closures.id,
      title: "Why interviewers ask about it",
      content: "Closures come up constantly in real code: counters, memoization, event handlers, and the module pattern all rely on them.\n\nInterviewers usually want to see that you can predict what a piece of code will log or return, not just recite the definition.",
      sortOrder: 1,
    },
  });

  await prisma.studyExample.upsert({
    where: { id: `${closures.id}-counter` },
    update: {},
    create: {
      id: `${closures.id}-counter`,
      topicId: closures.id,
      language: "javascript",
      code: "function makeCounter() {\n  let count = 0;\n  return function increment() {\n    count += 1;\n    return count;\n  };\n}\n\nconst counter = makeCounter();\ncounter(); // 1\ncounter(); // 2",
      explanation: "Each call to makeCounter() creates a brand new, private `count` variable. The returned `increment` function is a closure over that specific `count` — a second call to makeCounter() would get its own independent counter.",
      sortOrder: 0,
    },
  });

  await prisma.studyExercise.upsert({
    where: { id: `${closures.id}-exercise-1` },
    update: {},
    create: {
      id: `${closures.id}-exercise-1`,
      topicId: closures.id,
      question: "What does the following code log?\n\nfor (var i = 0; i < 3; i++) {\n  setTimeout(() => console.log(i), 0);\n}",
      difficulty: Difficulty.MEDIUM,
      hint: "Think about whether var is scoped to the loop body or to the whole function, and what value i holds by the time the timeouts actually run.",
      solution: "3\n3\n3",
      explanation: "var is function-scoped, not block-scoped, so all three callbacks close over the same single `i`. By the time any of the timeouts run, the loop has already finished and i is 3. (Using `let` instead of `var` would log 0, 1, 2, because `let` creates a fresh binding per iteration.)",
      sortOrder: 0,
    },
  });

  const equality = await prisma.studyTopic.upsert({
    where: { categoryId_slug: { categoryId: category.id, slug: "equality-and-type-coercion" } },
    update: {},
    create: {
      moduleId: learnModule.id,
      categoryId: category.id,
      title: "Equality and type coercion",
      slug: "equality-and-type-coercion",
      shortDescription: "The difference between == and ===, and the coercion rules that make the difference matter.",
      estimatedMinutes: 6,
      isPublished: true,
      sortOrder: 1,
      seoTitle: "JavaScript == vs === Explained",
      seoDescription: "How JavaScript's loose and strict equality operators differ, with the coercion rules and a practice exercise.",
    },
  });

  await prisma.studyTopicSection.upsert({
    where: { id: `${equality.id}-basics` },
    update: {},
    create: {
      id: `${equality.id}-basics`,
      topicId: equality.id,
      title: "== vs ===",
      content: "=== (strict equality) compares both value and type with no conversion. == (loose equality) converts the operands to a matching type first, then compares.\n\nAs a default, prefer === — it's predictable. Reach for == only when you deliberately want type coercion, and know exactly what that coercion will do.",
      sortOrder: 0,
    },
  });

  await prisma.studyExample.upsert({
    where: { id: `${equality.id}-examples` },
    update: {},
    create: {
      id: `${equality.id}-examples`,
      topicId: equality.id,
      language: "javascript",
      code: "0 == false;      // true  (false is coerced to 0)\n0 === false;     // false (different types)\n'' == false;     // true  ('' and false both coerce to 0)\nnull == undefined; // true (special-cased)\nnull === undefined; // false",
      explanation: "null == undefined is a specific, deliberate exception in the spec — those two are the only values that loosely equal each other, and nothing else.",
      sortOrder: 0,
    },
  });

  await prisma.studyExercise.upsert({
    where: { id: `${equality.id}-exercise-1` },
    update: {},
    create: {
      id: `${equality.id}-exercise-1`,
      topicId: equality.id,
      question: "Is [] == false true or false in JavaScript? Explain the coercion steps.",
      difficulty: Difficulty.EASY,
      hint: "An array on one side of == first gets converted to a primitive before the usual coercion rules apply.",
      solution: "true",
      explanation: "[] is converted to a primitive first, becoming the empty string ''. Then '' == false coerces both sides to numbers: '' becomes 0, and false becomes 0. 0 == 0 is true.",
      sortOrder: 0,
    },
  });

  // Best-effort: link each topic to one real, published interview question in
  // a JavaScript-flavoured category if the main seed (prisma/seed.ts) has
  // already run. Never creates a question — only references an existing one.
  const jsQuestion = await prisma.interviewQuestion.findFirst({
    where: { isPublished: true, category: { slug: { in: ["javascript-developer", "react-developer", "web-developer"] } } },
    select: { id: true },
  });
  if (jsQuestion) {
    await prisma.studyTopicQuestionRelation.upsert({
      where: { topicId_questionId: { topicId: closures.id, questionId: jsQuestion.id } },
      update: {},
      create: { topicId: closures.id, questionId: jsQuestion.id, sortOrder: 0 },
    });
  }

  console.log("Study content seeded:", { category: category.slug, path: path.slug, module: learnModule.slug, topics: [closures.slug, equality.slug] });
}

main()
  .catch(error => {
    console.error(error);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
