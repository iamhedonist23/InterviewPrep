# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for future database and authentication phases. Never commit real values.
DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional: seed promotes this existing account to ADMIN.
ADMIN_EMAIL=
# Ads are disabled unless both values are configured. Never commit a real ID here.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
# Required for the daily inactive-resume cleanup cron (Vercel sends this as
# an Authorization: Bearer header). The endpoint refuses all requests if this
# is unset, so deployments without it simply skip cleanup rather than being
# left open.
CRON_SECRET=
